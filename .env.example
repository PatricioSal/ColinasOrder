# ==============================================================================
#  WhatsApp Order Bot - Environment Configuration Template
#  Copy this file to `.env` and adjust database credentials as needed.
# ==============================================================================

# --- Local PostgreSQL Settings (Created by EASY_SETUP) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whatsapp_orders
DB_USER=openpg
DB_PASSWORD=openpgpwd

# --- SQL Server Integration ---
# Set to True to push finalized draft orders directly to SQL Server
# Set to False for local-only testing
PUSH_TO_MSSQL=False

# --- ODBC Connection String for SQL Server ---
# REPLACE USERNAME AND PASSWORD WITH YOUR ACTUAL CREDENTIALS
MSSQL_CONN_STR="DRIVER={ODBC Driver 18 for SQL Server};SERVER=your_sql_server_ip,port;DATABASE=your_database_name;UID=your_sql_username;PWD=your_sql_password;Encrypt=yes;TrustServerCertificate=yes;"

# --- Meta WhatsApp Cloud API Settings (Optional) ---
# Only needed if you are using Meta Cloud API webhook instead of the local node listener
WHATSAPP_API_KEY=mock_api_key_for_testing_12345
WHATSAPP_PHONE_NUMBER_ID=1234567890
